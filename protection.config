[protection]
# 修改后重启服务生效。直连、单进程部署可直接使用以下默认值。
enabled = true
# true 时仅记录命中规则，不拦截请求；用于观察和校准阈值。
observe_only = false

# 令牌桶：持续补充额度，burst 是最大突发额度，超限不排队。
chat_ip_per_minute = 120
chat_global_per_minute = 240
chat_ip_burst = 12
chat_global_burst = 24
chat_ip_concurrency = 8
chat_global_concurrency = 12

# 辅助接口、未知路径和不支持的方法共用另一组额度。
auxiliary_ip_per_minute = 120
auxiliary_global_per_minute = 600
auxiliary_ip_burst = 30
auxiliary_global_burst = 120

scan_window_seconds = 60
scan_threshold = 5
ban_seconds = 900
max_sources = 4096
idle_seconds = 1800

# 默认忽略转发头。仅在确认代理会正确写入 X-Forwarded-For 后填写
# 代理的准确 IP/CIDR，例如 127.0.0.1/32；不要填写客户端地址或整个内网。
trusted_proxy_networks =
